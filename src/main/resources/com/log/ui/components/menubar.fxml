<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>

<MenuBar fx:id="menuBar" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.log.ui.MenubarController">
  <menus>
    <Menu mnemonicParsing="false" text="File">
      <items>
        <MenuItem fx:id="homePageBtn" mnemonicParsing="false" onAction="#openHomePage" text="Home" />
            <MenuItem fx:id="newProjectBtn" mnemonicParsing="false" onAction="#loadBasePropertiesView" text="New project" />
            <MenuItem mnemonicParsing="false" text="Open folder" />
            <MenuItem fx:id="saveAsBtn" mnemonicParsing="false" onAction="#openSaveFilePopup"  text="Save as" />
            <MenuItem mnemonicParsing="false" text="Retrieval page" onAction="#openRetrievalPage"/>
            <MenuItem fx:id="settingsBtn" mnemonicParsing="false" onAction="#openSettingsPagePopup"  text="Settings" />

        <MenuItem mnemonicParsing="false" text="Exit" />
      </items>
    </Menu>
    <Menu mnemonicParsing="false" text="Edit">
      <items>
        <MenuItem mnemonicParsing="false" text="Project Details" fx:id="editprojbtn" onAction="#openbaseprops" />
      </items>
    </Menu>
    <Menu mnemonicParsing="false" text="Help">
      <items>
        <MenuItem mnemonicParsing="false" text="About" />
      </items>
    </Menu>
  </menus>
</MenuBar>

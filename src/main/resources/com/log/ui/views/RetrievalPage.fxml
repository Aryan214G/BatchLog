<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800"
            prefWidth="1200"
            stylesheets="
                @../styles/base/colors.css,
                @../styles/base/typography.css,
                @../styles/base/common.css,

                @../styles/components/buttons.css,
                @../styles/components/forms.css,
                @../styles/components/sidebar.css,
                @../styles/components/menubar.css,

                @../styles/pages/retrievalPage.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.log.ui.RetrievalPageController">

    <!-- ========================================= -->
    <!-- TOP -->
    <!-- ========================================= -->

    <top>
        <fx:include source="../components/menubar.fxml" />
    </top>

    <!-- ========================================= -->
    <!-- LEFT SIDEBAR -->
    <!-- ========================================= -->

    <left>

        <AnchorPane>

            <children>

                <VBox fx:id="sidebar"
                      styleClass="retrieval-sidebar"
                      AnchorPane.topAnchor="0.0"
                      AnchorPane.bottomAnchor="0.0">

                    <children>

                        <Label text="Filters"
                               styleClass="filter-title" />

                        <Label text="Project Name"
                               styleClass="filter-label" />

                        <TextField fx:id="projectField" />

                        <Label text="Product Name"
                               styleClass="filter-label" />

                        <TextField fx:id="productField" />

                        <Label text="Batch ID"
                               styleClass="filter-label" />

                        <TextField fx:id="BatchIDfield" />

                        <Label text="Date of Testing"
                               styleClass="filter-label" />

                        <TextField fx:id="Dateoftestingfield" />

                        <Label text="Place of Testing"
                               styleClass="filter-label" />

                        <TextField fx:id="Placeoftestingfield" />

                        <Label text="SOP"
                               styleClass="filter-label" />

                        <TextField fx:id="SOPfield" />

                        <Label text="Test Schedule"
                               styleClass="filter-label" />

                        <TextField fx:id="testschedulefield" />

                        <Button text="Search Products"
                                maxWidth="Infinity"
                                styleClass="primary-button"
                                onAction="#handleSearchProducts" />

                        <Button text="Search Batches"
                                maxWidth="Infinity"
                                styleClass="secondary-button"
                                onAction="#handleSearchBatches" />

                    </children>

                </VBox>

                <Button fx:id="toggleBtn"
                        text="☰"
                        styleClass="sidebar-toggle"
                        onAction="#toggleSidebar"
                        layoutX="285"
                        layoutY="10" />

            </children>

        </AnchorPane>

    </left>

    <!-- ========================================= -->
    <!-- CENTER CONTENT -->
    <!-- ========================================= -->

    <center>

        <VBox spacing="20"
              styleClass="results-panel">

            <children>

                <Label text="Results"
                       styleClass="results-title" />

                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="results-scroll">

                    <content>

                        <VBox fx:id="resultsContainer"
                              spacing="12">

                            <padding>
                                <Insets top="10"
                                        right="10"
                                        bottom="10"
                                        left="10" />
                            </padding>

                        </VBox>

                    </content>

                </ScrollPane>

            </children>

            <padding>
                <Insets top="24"
                        right="24"
                        bottom="24"
                        left="24" />
            </padding>

        </VBox>

    </center>

    <!-- ========================================= -->
    <!-- WINDOW PADDING -->
    <!-- ========================================= -->

    <padding>
        <Insets top="15"
                right="15"
                bottom="15"
                left="15" />
    </padding>

</BorderPane>
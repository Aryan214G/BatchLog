<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root"
            styleClass="root-layout"
            stylesheets="@../styles/settingsPage.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.log.ui.settings.SettingsPageController">

    <!-- ================= LEFT SIDEBAR ================= -->

    <left>

        <VBox spacing="15"
              styleClass="sidebar"
              BorderPane.alignment="CENTER">

            <children>

                <Label text="Settings"
                       alignment="CENTER"
                       maxWidth="Infinity"
                       styleClass="sidebar-title"/>

                <ScrollPane fitToWidth="true"
                            fitToHeight="true"
                            pannable="true"
                            VBox.vgrow="ALWAYS">

                    <content>

                        <VBox spacing="20">

                            <children>

                                <Button fx:id="defaultsBtn"
                                        text="Set Defaults"
                                        onAction="#showDefaultsPage"
                                        maxWidth="Infinity"/>

                                <Button fx:id="defunitsBtn"
                                        text="Add Units"
                                        onAction="#showUnitsPage"
                                        maxWidth="Infinity"/>

                                <Button fx:id="directionsBtn"
                                        text="Add Directions"
                                        onAction="#showDirectionsPage"
                                        maxWidth="Infinity"/>

                                <Button fx:id="addrenameunits"
                                        text="Rename/Add Temperature Units and Directions"
                                        wrapText="true"
                                        onAction="#showAddTempUnitsPage"
                                        maxWidth="Infinity"/>

                                <Button fx:id="catbutton"
                                        text="Add Categories and Properties"
                                        wrapText="true"
                                        onAction="#showCategoriesPage"
                                        maxWidth="Infinity"/>

                                <Button fx:id="renamecatprop"
                                        text="Rename Categories and Properties"
                                        wrapText="true"
                                        onAction="#showCategoriesrenamePage"
                                        maxWidth="Infinity"/>

                                <Button fx:id="backupBtn"
                                        text="Backup and Restore"
                                        onAction="#showBackupPage"
                                        maxWidth="Infinity"/>

                            </children>

                        </VBox>

                    </content>

                </ScrollPane>

            </children>

        </VBox>

    </left>

    <!-- ================= RIGHT CONTENT AREA ================= -->

    <center>

        <StackPane fx:id="contentArea"
                   styleClass="content-area"
                   BorderPane.alignment="CENTER"/>

    </center>

    <!-- ================= BOTTOM BAR ================= -->

    <bottom>

        <VBox styleClass="bottombar"/>

    </bottom>

    <!-- ================= WINDOW PADDING ================= -->

    <padding>

        <Insets top="15"
                right="15"
                bottom="15"
                left="15"/>

    </padding>

</BorderPane>
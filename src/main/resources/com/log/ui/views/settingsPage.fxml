<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root"
            prefHeight="800.0"
            prefWidth="1200.0"
            styleClass="root-layout"
            stylesheets="@../styles/settingsPage.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.log.ui.SettingsPageController">

    <!-- LEFT SIDEBAR -->

    <left>
        <VBox styleClass="sidebar"
              spacing="15"
              BorderPane.alignment="CENTER">

            <children>

                <Label alignment="CENTER"
                       maxWidth="1.7976931348623157E308"
                       styleClass="sidebar-title"
                       text="Settings" />

                <Button fx:id="defaultsBtn"
                        mnemonicParsing="false"
                        prefHeight="74.0"
                        prefWidth="218.0"
                        text="Set defaults"
                        onAction="#showDefaultsPage" />

                <Button fx:id="unitsBtn"
                        mnemonicParsing="false"
                        prefHeight="79.0"
                        prefWidth="218.0"
                        text="Add or remove Units"
                        onAction="#showUnitsPage" />

                <Button fx:id="directionsBtn"
                        mnemonicParsing="false"
                        prefHeight="74.0"
                        prefWidth="218.0"
                        text="Add or remove Directions"
                        onAction="#showDirectionsPage" />

                <Button fx:id="categoriesBtn"
                        mnemonicParsing="false"
                        prefHeight="82.0"
                        prefWidth="218.0"
                        text="Add or remove Categories"
                        onAction="#showCategoriesPage" />

                <ListView fx:id="categoriesListView"
                          prefHeight="353.0"
                          prefWidth="218.0"
                          styleClass="buttons-list"
                          VBox.vgrow="ALWAYS" />

            </children>
        </VBox>
    </left>

    <!-- RIGHT DYNAMIC CONTENT AREA -->

    <center>

        <StackPane fx:id="contentArea"
                   styleClass="content-area"
                   BorderPane.alignment="CENTER" />

    </center>

    <!-- BOTTOM BAR -->

    <bottom>

        <VBox>
            <children>
                <VBox styleClass="bottombar" />
            </children>
        </VBox>

    </bottom>

    <!-- WINDOW PADDING -->

    <padding>
        <Insets top="15.0"
                right="15.0"
                bottom="15.0"
                left="15.0" />
    </padding>

</BorderPane>
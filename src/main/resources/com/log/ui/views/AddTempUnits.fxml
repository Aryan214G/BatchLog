<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.log.ui.settings.Addtempunitscontroller"
            fitToWidth="true"
            fitToHeight="true"
            pannable="true">
    <content>
<AnchorPane prefHeight="500.0"
            prefWidth="700.0">

    <VBox spacing="15.0"
          AnchorPane.topAnchor="20.0"
          AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0"
          AnchorPane.bottomAnchor="20.0">

        <!-- Temperature Units -->

        <Label text="Temperature Units"
               style="-fx-font-size:16px; -fx-font-weight:bold;" />

        <HBox spacing="10">

            <TextField fx:id="temperatureUnitField"
                       promptText="Enter temperature unit"
                       HBox.hgrow="ALWAYS"/>

            <Button text="Add"
                    onAction="#handleAddTemperatureUnit"/>

            <Button text="Rename"
                    onAction="#handleRenameTemperatureUnit"/>
        </HBox>

        <ListView fx:id="temperatureUnitList"
                  prefHeight="150"/>

        <Separator />

        <!-- Directions -->

        <Label text="Directions"
               style="-fx-font-size:16px; -fx-font-weight:bold;" />

        <HBox spacing="10">

            <TextField fx:id="directionField"
                       promptText="Enter direction"
                       HBox.hgrow="ALWAYS"/>

            <Button text="Add"
                    onAction="#handleAddDirection"/>

            <Button text="Rename"
                    onAction="#handleRenameDirection"/>
        </HBox>

        <ListView fx:id="directionList"
                  prefHeight="150"/>

        <Separator />

        <HBox spacing="10">

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Close"
                    onAction="#handleClose"/>

        </HBox>

    </VBox>

</AnchorPane>
    </content>
</ScrollPane>
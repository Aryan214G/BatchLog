<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="460.0"
            prefWidth="340.0"
            stylesheets="
                @../styles/base/colors.css,
                @../styles/base/typography.css,
                @../styles/base/common.css,

                @../styles/components/buttons.css,
                @../styles/components/forms.css,

                @../styles/pages/filterPopup.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.log.ui.FilterPopupController">

    <!-- ========================================= -->
    <!-- HEADER -->
    <!-- ========================================= -->

    <top>

        <VBox alignment="CENTER">

            <children>

                <Label text="Filter"
                       styleClass="filter-title" />

            </children>

            <padding>
                <Insets top="20"
                        bottom="16" />
            </padding>

        </VBox>

    </top>

    <!-- ========================================= -->
    <!-- CONTENT -->
    <!-- ========================================= -->

    <center>

        <TabPane tabClosingPolicy="UNAVAILABLE"
                 styleClass="filter-tab-pane">

            <!-- Columns -->

            <tabs>

                <Tab text="Columns">

                    <content>

                        <ScrollPane fitToWidth="true">

                            <content>

                                <VBox fx:id="columnCheckboxContainer"
                                      spacing="12">

                                    <padding>
                                        <Insets top="16"
                                                right="20"
                                                bottom="16"
                                                left="20" />
                                    </padding>

                                </VBox>

                            </content>

                        </ScrollPane>

                    </content>

                </Tab>

                <!-- Properties -->

                <Tab text="Properties">

                    <content>

                        <ScrollPane fitToWidth="true">

                            <content>

                                <VBox fx:id="propertyCheckboxContainer"
                                      spacing="12">

                                    <padding>
                                        <Insets top="16"
                                                right="20"
                                                bottom="16"
                                                left="20" />
                                    </padding>

                                </VBox>

                            </content>

                        </ScrollPane>

                    </content>

                </Tab>

            </tabs>

        </TabPane>

    </center>

    <!-- ========================================= -->
    <!-- FOOTER -->
    <!-- ========================================= -->

    <bottom>

        <VBox>

            <children>

                <Separator />

                <HBox alignment="CENTER_RIGHT"
                      spacing="10"
                      styleClass="filter-footer">

                    <children>

                        <Button text="Cancel"
                                styleClass="secondary-button"
                                onAction="#handleCancel" />

                        <Button text="Apply"
                                styleClass="primary-button"
                                onAction="#handleApply" />

                    </children>

                    <padding>
                        <Insets top="12"
                                right="16"
                                bottom="16"
                                left="16" />
                    </padding>

                </HBox>

            </children>

        </VBox>

    </bottom>

</BorderPane>
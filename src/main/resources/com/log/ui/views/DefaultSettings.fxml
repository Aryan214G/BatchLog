<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextField?>
<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.log.ui.DefaultsSettingsController"
      alignment="TOP_CENTER"
      spacing="30"
      styleClass="entries-panel">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>

    <children>

        <!-- PAGE TITLE -->

        <Label text="Default Settings"
               style="-fx-font-size: 32px;
                      -fx-font-weight: bold;" />

        <!-- SETTINGS ROW -->

        <HBox spacing="25"
              alignment="CENTER"
              maxWidth="1000">

            <children>

                <!-- PROPERTY -->

                <VBox spacing="10">

                    <children>

                        <Label text="Property"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;" />

                        <ComboBox fx:id="propertyComboBox"
                                  prefWidth="180"
                                  promptText="Select"/>

                    </children>

                </VBox>

                <!-- DEFAULT UNIT -->

                <VBox spacing="10">

                    <children>

                        <Label text="Default Unit"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;" />

                        <ComboBox fx:id="unitComboBox"
                                  prefWidth="180"
                                  promptText="Select"/>

                    </children>

                </VBox>

                <!-- DEFAULT NUMBER OF FIELDS -->

                <VBox spacing="10">

                    <children>

                        <Label text="Default Number of Fields"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;" />

                        <TextField fx:id="fields" promptText="Enter Number of Default Rows" />


                    </children>

                </VBox>

            </children>

        </HBox>

        <!-- BUTTON ROW -->

        <HBox spacing="20"
              alignment="CENTER">

            <children>

                <!-- SAVE BUTTON -->

                <Button fx:id="saveButton"
                        onAction="#saveChanges"
                        text="Save Changes"
                        prefWidth="200"
                        prefHeight="45"
                        style="-fx-font-size: 16px;
                               -fx-font-weight: bold;" />

                <!-- CANCEL BUTTON -->

                <Button fx:id="cancelButton"
                        onAction="#cancelChanges"
                        text="Cancel"
                        prefWidth="160"
                        prefHeight="45"
                        style="-fx-font-size: 16px;
                               -fx-font-weight: bold;" />

            </children>

        </HBox>

    </children>

</VBox>
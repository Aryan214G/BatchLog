<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="30"
      styleClass="entries-panel"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.log.ui.settings.DefaultsSettingsController">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30" />
    </padding>

    <children>

        <!-- ========================================= -->
        <!-- PAGE TITLE -->
        <!-- ========================================= -->

        <Label text="Default Settings"
               styleClass="settings-page-title" />

        <!-- ========================================= -->
        <!-- SETTINGS CARD -->
        <!-- ========================================= -->

        <HBox alignment="CENTER"
              maxWidth="1000"
              spacing="25"
              styleClass="settings-card">

            <children>

                <!-- PROPERTY -->

                <VBox spacing="10">

                    <children>

                        <Label text="Property"
                               styleClass="settings-section-label" />

                        <ComboBox fx:id="propertyComboBox"
                                  prefWidth="220"
                                  promptText="Select Property" />

                    </children>

                </VBox>

                <!-- DEFAULT UNIT -->

                <VBox spacing="10">

                    <children>

                        <Label text="Default Unit"
                               styleClass="settings-section-label" />

                        <ComboBox fx:id="unitComboBox"
                                  prefWidth="220"
                                  promptText="Select Unit" />

                    </children>

                </VBox>

                <!-- DEFAULT ROWS -->

                <VBox spacing="10">

                    <children>

                        <Label text="Default Number of Fields"
                               styleClass="settings-section-label" />

                        <TextField fx:id="fields"
                                   prefWidth="250"
                                   promptText="Enter number of rows" />

                    </children>

                </VBox>

            </children>

        </HBox>

        <!-- ========================================= -->
        <!-- CHECKBOX -->
        <!-- ========================================= -->

        <CheckBox fx:id="componentNumberCheckBox"
                  styleClass="settings-checkbox"
                  text="Display component number fields for this property" />

        <!-- ========================================= -->
        <!-- BUTTONS -->
        <!-- ========================================= -->

        <HBox alignment="CENTER"
              spacing="20"
              styleClass="settings-button-row">

            <children>

                <Button fx:id="saveButton"
                        onAction="#saveChanges"
                        styleClass="primary-button"
                        text="Save Changes" />

                <Button fx:id="cancelButton"
                        onAction="#cancelChanges"
                        styleClass="secondary-button"
                        text="Cancel" />

            </children>

        </HBox>

    </children>

</VBox>
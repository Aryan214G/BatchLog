<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="30"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.log.ui.settings.UnitsSettingsController">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>

    <children>

        <!-- ========================================= -->
        <!-- PAGE TITLE -->
        <!-- ========================================= -->

        <Label text="Property Units Settings"
               styleClass="settings-page-title"/>

        <!-- ========================================= -->
        <!-- SETTINGS CARD -->
        <!-- ========================================= -->

        <VBox alignment="TOP_CENTER"
              spacing="18"
              styleClass="settings-card">

            <children>

                <!-- PROPERTY -->

                <Label text="Property"
                       styleClass="settings-section-label"/>

                <ComboBox fx:id="propertyComboBox"
                          prefWidth="400"
                          promptText="Select Property"/>

                <!-- CURRENT UNITS -->

                <Label text="Units Assigned To Property"
                       styleClass="settings-section-label"/>

                <ListView fx:id="unitsListView"
                          prefHeight="220"
                          prefWidth="400"/>

                <!-- EXISTING UNITS -->

                <Label text="Add from Existing Units"
                       styleClass="settings-section-label"/>

                <ComboBox fx:id="availableUnitsComboBox"
                          prefWidth="400"
                          promptText="Select Existing Unit"/>

                <!-- NEW UNIT -->

                <Label text="Or Create New Unit"
                       styleClass="settings-section-label"/>

                <TextField fx:id="newUnitField"
                           prefWidth="400"
                           promptText="Enter New Unit"/>

            </children>

        </VBox>

        <!-- ========================================= -->
        <!-- BUTTONS -->
        <!-- ========================================= -->

        <HBox alignment="CENTER"
              spacing="16"
              styleClass="settings-button-row">

            <children>

                <Button onAction="#addUnit"
                        styleClass="primary-button"
                        text="Add Unit"/>

                <Button onAction="#removeUnit"
                        styleClass="secondary-button"
                        text="Remove Selected Unit"/>

            </children>

        </HBox>

    </children>

</VBox>
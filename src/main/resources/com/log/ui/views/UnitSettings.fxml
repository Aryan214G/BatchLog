<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.log.ui.UnitsSettingsController">

    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <children>

        <!-- Title -->

        <Label style="-fx-font-size: 28px;                       -fx-font-weight: bold;" text="Property Units Settings" />

        <!-- Property Selection -->

        <Label text="Property" />

        <ComboBox fx:id="propertyComboBox" prefWidth="350" promptText="Select Property" />

        <!-- Current Units -->

        <Label text="Units Assigned To Property" />

        <ListView fx:id="unitsListView" prefHeight="200" prefWidth="350" />

        <!-- Existing Units -->

        <Label text="Add from existing units" />

        <ComboBox fx:id="availableUnitsComboBox" prefWidth="350" promptText="Select Existing Unit" />

        <!-- Custom Unit -->

        <Label text="Or create new unit" />

        <TextField fx:id="newUnitField" prefWidth="350" promptText="Enter New Unit" />

        <!-- Actions -->

        <HBox alignment="CENTER" spacing="15">

            <children>

                <Button onAction="#addUnit" prefWidth="140" text="Add Unit" />

                <Button onAction="#removeUnit" prefWidth="180" text="Remove Selected Unit" />

            </children>

        </HBox>

    </children>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" styleClass="root-layout" stylesheets="@../styles/AddCategoriesStyles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.log.ui.NewProjectPopupController">

    <!-- ===== TITLE ===== -->
    <top>
        <VBox alignment="CENTER">
            <padding>
                <Insets bottom="20" top="30" />
            </padding>
            <Label styleClass="title" text="Add Project" />
        </VBox>
    </top>

    <!-- ===== CENTER CONTENT ===== -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="30" styleClass="content-area">

            <!-- Property Name -->
            <VBox maxWidth="600" spacing="6" styleClass="input-field-container">
                <Label text="Project Name" />
                <TextField fx:id="projectNameField" promptText="Value" styleClass="input-field" />
            </VBox>

            <Button onAction="#handleSaveProject" prefWidth="200" styleClass="primary-btn" text="Save Project" />

        </VBox>
    </center>

    <!-- ===== SAVE BUTTON ===== -->
    <bottom>
        <VBox alignment="CENTER" prefHeight="0.0" prefWidth="800.0">
            <padding>
                <Insets bottom="30" top="20" />
            </padding>
        </VBox>
    </bottom>

</BorderPane>

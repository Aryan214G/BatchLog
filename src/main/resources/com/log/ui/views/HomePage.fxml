<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextField?>
<BorderPane prefHeight="800" prefWidth="1200"
            stylesheets="
            @../styles/base/colors.css,
            @../styles/base/typography.css,
            @../styles/base/common.css,

            @../styles/components/buttons.css,
            @../styles/components/forms.css,
            @../styles/components/cards.css,
            @../styles/components/listviews.css,
            @../styles/components/sidebar.css,
            @../styles/components/infoBar.css,

            @../styles/pages/homePage.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.log.ui.HomePageController">

    <top>
        <fx:include source="../components/menubar.fxml" />
    </top>

    <!-- ================= LEFT SIDEBAR ================= -->
    <left>
        <VBox spacing="15" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="app-title" text="BatchLog" />
                <Button fx:id="newProjectBtn"    maxWidth="Infinity" styleClass="sidebar-button" text="New Project" />
                <Button fx:id="retrievalPageBtn" maxWidth="Infinity" styleClass="sidebar-button" text="Retrieval Page" />
                <Button fx:id="settingsPageBtn"  maxWidth="Infinity" styleClass="sidebar-button" text="Settings" />
                <Button fx:id="helpPageBtn"      maxWidth="Infinity" styleClass="sidebar-button" text="Help" />
            </children>
            <padding>
                <Insets bottom="20" left="15" right="15" top="20" />
            </padding>
        </VBox>
    </left>

    <!-- ================= CENTER CONTENT ================= -->
    <center>

        <VBox spacing="20" styleClass="content-area">

            <children>

                <Label styleClass="section-title"
                       text="Recent Projects" />

                <TextField fx:id="projectSearchField"
                           promptText="Search projects..." />

                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS">

                    <content>

                        <VBox fx:id="projectsList"
                              spacing="8">

                            <padding>
                                <Insets bottom="10"
                                        left="10"
                                        right="10"
                                        top="10" />
                            </padding>

                        </VBox>

                    </content>

                </ScrollPane>

            </children>

            <padding>
                <Insets bottom="20"
                        left="20"
                        right="20"
                        top="20" />
            </padding>

        </VBox>

    </center>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="30"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.log.ui.settings.DirectionSettingsController">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>

    <children>

        <!-- ========================================= -->
        <!-- PAGE TITLE -->
        <!-- ========================================= -->

        <Label text="Direction Settings"
               styleClass="settings-page-title"/>

        <!-- ========================================= -->
        <!-- SETTINGS CARD -->
        <!-- ========================================= -->

        <VBox alignment="TOP_CENTER"
              spacing="18"
              styleClass="settings-card">

            <children>

                <Label text="Available Directions"
                       styleClass="settings-section-label"/>

                <ListView fx:id="directionsListView"
                          prefHeight="250"
                          prefWidth="400"/>

                <Label text="Add New Direction"
                       styleClass="settings-section-label"/>

                <TextField fx:id="directionField"
                           prefWidth="400"
                           promptText="Enter New Direction"/>

            </children>

        </VBox>

        <!-- ========================================= -->
        <!-- BUTTONS -->
        <!-- ========================================= -->

        <HBox alignment="CENTER"
              spacing="16"
              styleClass="settings-button-row">

            <children>

                <Button onAction="#addDirection"
                        styleClass="primary-button"
                        text="Add Direction"/>

            </children>

        </HBox>

    </children>

</VBox>
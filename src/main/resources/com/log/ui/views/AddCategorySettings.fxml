<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
        <VBox spacing="15"
              alignment="TOP_CENTER"
              xmlns="http://javafx.com/javafx/25"
              xmlns:fx="http://javafx.com/fxml/1"
              fx:controller="com.log.ui.settings.CategorySettingsController">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <!-- ===== TITLE ===== -->

            <Label text="Category Settings"/>

            <!-- ===== CATEGORY SECTION ===== -->

            <Label text="Category Name"/>

            <HBox spacing="10">

                <TextField fx:id="categoryField"
                           promptText="Enter category name"
                           HBox.hgrow="ALWAYS"/>

                <Button text="Add Category"
                        onAction="#handleAddCategory"/>

            </HBox>

            <ListView fx:id="categoryList"
                      prefHeight="120"/>

            <!-- ===== PROPERTY SECTION ===== -->

            <Label text="Property Name"/>

            <TextField fx:id="propertyField"
                       promptText="Enter property name"/>

            <Label text="Default Rows"/>

            <TextField fx:id="rowsField"
                       promptText="Enter default rows (e.g. 1)"/>

            <!-- ===== UNIT SECTION ===== -->

            <Label text="Default Unit"/>

            <ComboBox fx:id="unitComboBox"
                      promptText="Select existing unit"
                      maxWidth="Infinity"/>

            <TextField fx:id="customUnitField"
                       promptText="Or enter a new unit"/>

            <Button text="Add Property"
                    onAction="#handleAddProperty"/>

            <ListView fx:id="propertyList"
                      prefHeight="150"/>

        </VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="30" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.log.ui.settings.CategorySettingsController">

    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <children>

        <!-- ========================================= -->
        <!-- PAGE TITLE -->
        <!-- ========================================= -->

        <Label styleClass="settings-page-title" text="Category Settings" />
      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
         <content>
      
              <!-- ========================================= -->
              <!-- SETTINGS CARD -->
              <!-- ========================================= -->
      
              <VBox spacing="18" styleClass="settings-card">
      
                  <children>
      
                      <!-- CATEGORY SECTION -->
      
                      <Label styleClass="settings-section-label" text="Category Name" />
      
                      <HBox spacing="12" styleClass="action-row">
      
                          <children>
      
                              <TextField fx:id="categoryField" promptText="Enter category name" HBox.hgrow="ALWAYS" />
      
                              <Button onAction="#handleAddCategory" styleClass="primary-button" text="Add Category" />
      
                          </children>
      
                      </HBox>
      
                      <ListView fx:id="categoryList" minHeight="140.0" prefHeight="140" />
      
                      <!-- PROPERTY SECTION -->
      
                      <Label styleClass="settings-section-label" text="Property Name" />
      
                      <TextField fx:id="propertyField" promptText="Enter property name" />
      
                      <Label styleClass="settings-section-label" text="Default Rows" />
      
                      <TextField fx:id="rowsField" promptText="Enter default rows (e.g. 1)" />
      
                      <Label styleClass="settings-section-label" text="Default Unit" />
      
                      <ComboBox fx:id="unitComboBox" promptText="Select existing unit" />
      
                      <TextField fx:id="customUnitField" promptText="Or enter a new unit" />
      
                      <Button onAction="#handleAddProperty" styleClass="primary-button" text="Add Property" />
      
                      <ListView fx:id="propertyList" minHeight="140.0" prefHeight="180" />
      
                  </children>
      
              </VBox>
         </content>
      </ScrollPane>

    </children>

</VBox>

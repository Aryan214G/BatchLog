<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800" prefWidth="1200" stylesheets="@../styles/RetrievalResultsPage.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.log.ui.ProjectPageController">

    <top>
        <fx:include source="../components/menubar.fxml" />
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets bottom="24" left="24" right="24" top="24" />
            </padding>

            <!-- Back button + actions row -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button onAction="#handleBack" styleClass="back-btn" text="← Back" />
                <Button onAction="#handleNewBatch" styleClass="primary-btn" text="+ New Batch" />
            <Button fx:id="exportButton" mnemonicParsing="false" onAction="#handleExport" text="Export" />
            </HBox>

            <Label fx:id="projectTitleLabel" styleClass="batch-title" />

            <ScrollPane fitToWidth="true" styleClass="table-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <GridPane fx:id="batchesGrid" styleClass="property-table">
                        <padding>
                            <Insets bottom="0" left="0" right="0" top="0" />
                        </padding>
                    </GridPane>
                </content>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>

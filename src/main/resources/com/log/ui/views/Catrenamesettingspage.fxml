<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.log.ui.Catrenamesettingspagecontroller"
            fitToWidth="true"
            fitToHeight="true"
            pannable="true">
<content>
<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <top>
        <Label text="Rename Categories and Properties"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>

        <HBox spacing="20">

            <!-- Categories -->

            <VBox spacing="10" HBox.hgrow="ALWAYS">

                <Label text="Categories"/>

                <ListView fx:id="categoryList"
                          prefHeight="300"/>

                <TextField fx:id="categoryNameField"
                           promptText="New category name"/>

                <Button text="Rename Category"
                        onAction="#handleRenameCategory"/>
            </VBox>

            <!-- Properties -->

            <VBox spacing="10" HBox.hgrow="ALWAYS">

                <Label text="Properties"/>

                <ListView fx:id="propertyList"
                          prefHeight="300"/>

                <TextField fx:id="propertyNameField"
                           promptText="New property name"/>

                <Button text="Rename Property"
                        onAction="#handleRenameProperty"/>
            </VBox>

        </HBox>

    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              spacing="10">

            <padding>
                <Insets top="15"/>
            </padding>

            <Button text="Close"
                    onAction="#handleClose"/>
        </HBox>
    </bottom>

</BorderPane>
</content>
</ScrollPane>